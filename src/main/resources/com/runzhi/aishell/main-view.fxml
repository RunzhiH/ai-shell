<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<!--
  AIShell 主视图 — 对齐 HTML：Server | Terminal | AI
  保留：MenuBar 全部系统入口、contentArea（viewSwitcher）、statusLabel、侧栏监控 Label
  不删：Agent 工作区（在 terminal-panel 内 SplitPane）
-->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.runzhi.aishell.controller.MainViewController"
      styleClass="main-view"
      VBox.vgrow="ALWAYS">
    <children>

        <!-- 系统菜单（保留，功能不丢） -->
        <MenuBar VBox.vgrow="NEVER">
            <menus>
                <Menu text="%main.file">
                    <items>
                        <MenuItem text="%main.newConfig" onAction="#newConnection"/>
                        <MenuItem text="%main.openConfig" onAction="#openConfig"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="%main.import" onAction="#handleImportConnections"/>
                        <MenuItem text="%main.export" onAction="#handleExportConnections"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="%main.settings" onAction="#openSettings"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="%main.exit" onAction="#exitApplication"/>
                    </items>
                </Menu>
                <Menu text="%main.connections">
                    <items>
                        <MenuItem text="%main.manageConnections" onAction="#connectToServer"/>
                        <MenuItem text="%main.reconnectAll" onAction="#reconnectAllTerminals"/>
                        <MenuItem text="%main.disconnect" onAction="#disconnectFromServer"/>
                    </items>
                </Menu>
                <Menu text="%main.view">
                    <items>
                        <MenuItem text="%main.terminal" onAction="#openTerminal"/>
                        <MenuItem text="%main.monitorPanel" onAction="#openMonitor"/>
                        <MenuItem text="%main.advancedMonitor" onAction="#openAdvancedMonitorCharts"/>
                        <MenuItem text="%main.files" onAction="#openFiles"/>
                        <MenuItem text="%main.systemInfo" onAction="#openSystemInfo"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="%main.bookmarks" onAction="#openBookmarkPanel"/>
                        <MenuItem text="%main.history" onAction="#openCommandHistory"/>
                    </items>
                </Menu>
                <Menu text="AI">
                    <items>
                        <MenuItem text="%workbench.aiAssistant" onAction="#openAIAssistant"/>
                        <MenuItem text="%workbench.agent" onAction="#openAgentWorkspace"/>
                    </items>
                </Menu>
                <Menu text="%main.help">
                    <items>
                        <MenuItem text="%main.support" onAction="#openDonation"/>
                        <MenuItem text="%main.about" onAction="#openAbout"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>

        <!-- 顶栏：导航 + 当前连接 + 主操作（HTML 同款） -->
        <HBox styleClass="topbar" spacing="8" alignment="CENTER_LEFT" minHeight="56" prefHeight="56">
            <children>
                <Label text="AIShell" styleClass="brand-name"/>
                <Label text="SSH + AI" styleClass="brand-tag"/>
                <HBox spacing="2" styleClass="top-nav" alignment="CENTER_LEFT">
                    <Button minWidth="-Infinity" fx:id="navConnections" text="%main.connections" onAction="#openConnectionList" styleClass="nav-item" mnemonicParsing="false"/>
                    <Button minWidth="-Infinity" fx:id="navTerminal" text="%main.terminal" onAction="#openTerminal" styleClass="nav-item" mnemonicParsing="false"/>
                    <Button minWidth="-Infinity" fx:id="navFiles" text="%main.files" onAction="#openFiles" styleClass="nav-item" mnemonicParsing="false"/>
                    <Button minWidth="-Infinity" fx:id="navMonitor" text="%main.monitor" onAction="#openMonitor" styleClass="nav-item" mnemonicParsing="false"/>
                    <Button minWidth="-Infinity" fx:id="navAI" text="%workbench.aiAssistant" onAction="#openAIAssistant" styleClass="nav-item" mnemonicParsing="false">
                        <tooltip><Tooltip text="%workbench.aiAssistant.tip"/></tooltip>
                    </Button>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- 当前目标：只放短标识，完整目标由代码写入 tooltip，避免挤压与重复拼接 -->
                <HBox spacing="6" alignment="CENTER_LEFT" minWidth="140" prefWidth="240" maxWidth="340" HBox.hgrow="SOMETIMES">
                    <Label text="●" fx:id="hostStatusDot" style="-fx-text-fill: -fx-success-color;"/>
                    <Label fx:id="currentHostLabel" text="%main.disconnected" styleClass="current-host-value" minWidth="0" maxWidth="320" HBox.hgrow="ALWAYS" textOverrun="ELLIPSIS">
                        <tooltip><Tooltip text="${currentHostLabel.text}"/></tooltip>
                    </Label>
                </HBox>
                <Button minWidth="-Infinity" fx:id="btnToggleServer" text="%main.servers" onAction="#toggleServerPanel" styleClass="nav-item" mnemonicParsing="false"/>
                <Button minWidth="-Infinity" fx:id="btnTheme" text="%main.dark" onAction="#toggleTheme" styleClass="nav-item" mnemonicParsing="false"/>
                <Button minWidth="-Infinity" text="%main.newConnection" onAction="#newConnection" styleClass="primary-button" mnemonicParsing="false"/>
                <Button fx:id="btnCommandPalette" minWidth="-Infinity" text="%main.palette" onAction="#openCommandPalette" styleClass="nav-item" mnemonicParsing="false">
                    <tooltip>
                        <Tooltip text="%main.paletteTip"/>
                    </tooltip>
                </Button>
                <Button minWidth="-Infinity" text="%main.settings" onAction="#openSettings" styleClass="nav-item" mnemonicParsing="false"/>
            </children>
        </HBox>

        <!-- 主工作区：Server | Terminal | AI Agent；终端与 Agent 的比例可拖动并记忆 -->
        <SplitPane fx:id="mainSplitPane" orientation="HORIZONTAL" dividerPositions="0.14"
                   VBox.vgrow="ALWAYS" styleClass="main-split-pane">
            <items>

                <!-- 左：服务器 + 监控概览 -->
                <VBox fx:id="serverPanel" styleClass="main-sidebar"
                      minWidth="224" prefWidth="248" maxWidth="340"
                      HBox.hgrow="NEVER" managed="true" visible="true">
                    <children>
                        <HBox fx:id="serverPanelHead" styleClass="panel-head" alignment="CENTER_LEFT" spacing="6">
                            <Label text="%main.servers" styleClass="panel-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnCollapseServer" text="‹" onAction="#toggleServerPanel"
                                    styleClass="nav-item" mnemonicParsing="false"
                                    accessibleText="%main.collapseServers">
                                <tooltip>
                                    <Tooltip text="%main.collapseServers"/>
                                </tooltip>
                            </Button>
                        </HBox>

                        <TextField fx:id="serverTreeFilter" promptText="%main.filter"
                                   styleClass="sidebar-filter"/>

                        <!-- 服务器会话树：单击只选中，双击 / Enter 激活会话 -->
                        <TreeView fx:id="serverTree" VBox.vgrow="ALWAYS" minHeight="120"
                                  styleClass="server-tree"/>

                        <Label fx:id="serverPanelHint" text="%main.activateHint" styleClass="sidebar-hint"/>

                        <Separator fx:id="serverPanelSeparator"/>

                        <!-- 活动会话身份/指标固定为侧栏内独立滚动块，避免展开更多信息时被窗口裁掉 -->
                        <ScrollPane fx:id="activeSessionScroll" fitToWidth="true"
                                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" minHeight="0"
                                    styleClass="sidebar-scroll">
                            <content>
                                <VBox fx:id="activeSessionPanel" styleClass="active-session-panel"
                                      spacing="8" minWidth="0">
                                    <Label fx:id="activeSessionTitle" text="%main.activeEmpty"
                                           styleClass="sidebar-section-title" wrapText="true" maxWidth="Infinity"/>
                                    <Label fx:id="activeSessionName" text="%main.disconnected"
                                           styleClass="active-session-name" wrapText="true" maxWidth="Infinity"/>
                            <VBox fx:id="metricsGroup" spacing="8" visible="false" managed="false">
                                <HBox>
                                    <Label text="CPU" styleClass="system-info-label"/>
                                    <Label fx:id="cpuLabel" text="—" styleClass="system-info-value" HBox.hgrow="ALWAYS"/>
                                </HBox>
                                <HBox>
                                    <Label text="%main.memory" styleClass="system-info-label"/>
                                    <Label fx:id="memoryLabel" text="—" styleClass="system-info-value" HBox.hgrow="ALWAYS"/>
                                </HBox>
                                <HBox>
                                    <Label text="%main.load" styleClass="system-info-label"/>
                                    <Label fx:id="loadLabel" text="—" styleClass="system-info-value" HBox.hgrow="ALWAYS"/>
                                </HBox>
                                <HBox>
                                    <Label text="%main.network" styleClass="system-info-label"/>
                                    <Label fx:id="netLabel" text="—" styleClass="system-info-value" HBox.hgrow="ALWAYS"/>
                                </HBox>
                                <TitledPane text="%main.moreInfo" expanded="false" VBox.vgrow="NEVER"
                                            styleClass="sidebar-details">
                                    <content>
                                        <VBox spacing="8" styleClass="sidebar-details-content">
                                            <HBox>
                                                <Label text="%main.uptime" styleClass="system-info-label"/>
                                                <Label fx:id="uptimeLabel" text="—" styleClass="system-info-value" HBox.hgrow="ALWAYS"/>
                                            </HBox>
                                            <HBox>
                                                <Label text="%main.swap" styleClass="system-info-label"/>
                                                <Label fx:id="swapLabel" text="—" styleClass="system-info-value" HBox.hgrow="ALWAYS"/>
                                            </HBox>
                                            <Separator/>
                                            <Label text="%main.disk" styleClass="sidebar-section-title"/>
                                            <TableView fx:id="storageTable" prefHeight="150" VBox.vgrow="ALWAYS" styleClass="storage-table">
                                                <columns>
                                                    <TableColumn fx:id="pathColumn" text="%main.path" prefWidth="100.0"/>
                                                    <TableColumn fx:id="sizeColumn" text="%main.available" prefWidth="90.0"/>
                                                </columns>
                                                <columnResizePolicy>
                                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                                </columnResizePolicy>
                                            </TableView>
                                        </VBox>
                                    </content>
                                </TitledPane>
                            </VBox>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>

                <!-- Terminal 与右侧 Agent 在终端视图内组成可调分栏 -->
                <StackPane fx:id="contentArea" styleClass="terminal-panel"
                           HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"/>
            </items>
        </SplitPane>
    </children>

    <BorderPane styleClass="status-bar" minHeight="32" prefHeight="32">
        <left>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="statusTerminalTab" text="Terminal" styleClass="status-label"/>
                <Label fx:id="statusPageSeparator" text="·" styleClass="status-label"/>
                <Button fx:id="btnFilesDrawer" text="%main.files" onAction="#toggleFilesDrawer"
                        styleClass="status-item" mnemonicParsing="false"/>
            </HBox>
        </left>
        <center>
            <HBox spacing="10" alignment="CENTER">
                <Label text="%main.target" styleClass="status-label"/>
                <Label fx:id="statusHostLabel" text="—" styleClass="status-label"/>
                <Label text="%main.health" styleClass="status-label"/>
                <Label fx:id="statusHealthLabel" text="%main.ready" styleClass="status-ok"/>
                <Label text="Agent" styleClass="status-label"/>
                <Label fx:id="statusAiLabel" text="%main.ready" styleClass="status-ai"/>
                <Label fx:id="statusApprovalLocator" text="" styleClass="status-approval-locator"
                       onMouseClicked="#locateApproval" visible="false"/>
            </HBox>
        </center>
        <right>
            <Label fx:id="statusLabel" text="%main.ready" styleClass="status-label"
                   BorderPane.alignment="CENTER_RIGHT"/>
        </right>
    </BorderPane>
</VBox>
