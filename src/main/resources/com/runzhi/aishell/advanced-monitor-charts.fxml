<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!--
  资源分析：CPU/内存/磁盘容量/Swap 是不同分母的独立指标，不再混合进同一饼图；
  改为各自独立的资源条（保留口径与采样状态），进程状态分布保留饼图（有共同分母：进程总数）。
-->
<VBox xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.runzhi.aishell.controller.AdvancedMonitorChartsController"
      spacing="20.0" styleClass="advanced-charts-panel">

    <VBox spacing="4">
        <Label text="资源分析" styleClass="page-title"/>
        <Label text="查看系统资源与进程分布" styleClass="page-description"/>
    </VBox>

    <!-- 独立资源条：每项使用率单独表达，不混合分母 -->
    <TitledPane text="资源使用率" expanded="true">
        <VBox spacing="14" fx:id="resourceBarsBox"/>
    </TitledPane>

    <!-- 进程状态分布（运行/睡眠/停止/僵尸，分母为进程总数） -->
    <TitledPane text="进程状态分布" expanded="false" VBox.vgrow="ALWAYS">
        <PieChart fx:id="processTypePieChart" prefHeight="300.0" prefWidth="400.0"/>
    </TitledPane>

</VBox>
