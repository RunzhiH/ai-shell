<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<!--
  终端面板
  - Terminal 是主工作区，右侧 Agent 为协作面板，默认收起（用户偏好优先）
  - Agent 宽度可拖动并记忆；低频终端操作收纳在更多菜单
-->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.runzhi.aishell.controller.TerminalPanelController"
      styleClass="terminal-panel"
      VBox.vgrow="ALWAYS">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="4" styleClass="terminal-toolbar" minHeight="36">
            <children>
                <Button text="%terminal.new" onAction="#createNewTab" styleClass="toolbar-button" mnemonicParsing="false"/>
                <Button text="%terminal.reconnect" onAction="#attemptReconnection" styleClass="toolbar-button" mnemonicParsing="false"/>
                <Button text="%terminal.clear" onAction="#clearScreen" styleClass="toolbar-button" mnemonicParsing="false"/>
                <Button text="%terminal.copy" onAction="#copySelection" styleClass="toolbar-button" mnemonicParsing="false">
                    <tooltip><Tooltip text="%terminal.copy.tip"/></tooltip>
                </Button>
                <ToggleButton fx:id="btnAgentWorkspace" text="Agent" onAction="#toggleAgentWorkspace" styleClass="nav-item" mnemonicParsing="false">
                    <tooltip><Tooltip text="%workbench.agent.toggle"/></tooltip>
                </ToggleButton>
                <Region HBox.hgrow="ALWAYS"/>
                <MenuButton text="%terminal.more" styleClass="toolbar-button" mnemonicParsing="false">
                    <items>
                        <MenuItem text="%terminal.copy" onAction="#copySelection"/>
                        <MenuItem text="%terminal.paste" onAction="#pasteContent"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="%terminal.tunnels" onAction="#showPortForwarding"/>
                        <MenuItem text="%terminal.theme" onAction="#changeTheme"/>
                        <MenuItem text="%terminal.settings" onAction="#showSettings"/>
                    </items>
                </MenuButton>
            </children>
        </HBox>

        <!-- Terminal | Agent：终端绝对优先，Agent 可拖动收放 -->
        <SplitPane fx:id="terminalSplitPane" dividerPositions="1.0" VBox.vgrow="ALWAYS"
                   styleClass="terminal-split-pane">
            <items>
                <StackPane fx:id="terminalStack" styleClass="terminal-stack">
                    <TabPane fx:id="terminalTabPane"
                             minHeight="0.0"
                             minWidth="480"
                             tabClosingPolicy="ALL_TABS"
                             styleClass="terminal-tab-pane"/>
                </StackPane>
                <VBox fx:id="agentWorkspaceHost" visible="false" managed="false"
                      styleClass="agent-workspace-host" minWidth="280" prefWidth="360">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="panel-head" minHeight="36">
                            <Label text="%workbench.agent" styleClass="ai-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnHideAgentWorkspace" text="×" onAction="#toggleAgentWorkspace" styleClass="nav-item" mnemonicParsing="false"
                                    accessibleText="%workbench.agent.hide">
                                <tooltip>
                                    <Tooltip text="%workbench.agent.hide"/>
                                </tooltip>
                            </Button>
                        </HBox>
                        <fx:include fx:id="agentWorkspace" source="agent-workspace.fxml" VBox.vgrow="ALWAYS"/>
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </children>
</VBox>
