<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.runzhi.aishell.controller.BookmarkEditDialogController"
      prefWidth="500.0" spacing="15.0">
    
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    
    <!-- 标题 -->
    <Label fx:id="dialogTitleLabel" text="添加书签" styleClass="dialog-title"/>
    
    <!-- 表单区域 -->
    <GridPane hgap="10.0" vgap="10.0" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints percentWidth="30"/>
            <ColumnConstraints percentWidth="70"/>
        </columnConstraints>
        
        <!-- 名称 -->
        <Label text="名称:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" promptText="输入书签名称" 
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        
        <!-- 命令 -->
        <Label text="命令:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextArea fx:id="commandArea" promptText="输入命令内容" 
                  prefRowCount="4" wrapText="true"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        
        <!-- 描述 -->
        <Label text="描述:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="descriptionField" promptText="简要描述（可选）"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        
        <!-- 分类 -->
        <Label text="分类:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="categoryComboBox" promptText="选择或输入分类"
                  editable="true"
                  GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        
        <!-- 标签 -->
        <Label text="标签:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="tagsField" promptText="多个标签用逗号分隔（可选）"
                   GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        
        <!-- 启用状态 -->
        <Label text="状态:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <CheckBox fx:id="enabledCheckBox" text="启用此书签" selected="true"
                  GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>
    
    <!-- 按钮区域 -->
    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button text="取消" onAction="#handleCancel" cancelButton="true"/>
        <Button text="保存" onAction="#handleSave" defaultButton="true" styleClass="primary-button"/>
    </HBox>
    
</VBox>
