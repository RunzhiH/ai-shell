<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.control.cell.PropertyValueFactory?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.runzhi.aishell.controller.CommandHistoryDialogController"
      spacing="15" styleClass="history-dialog-container">
    
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>
    
    <!-- 标题栏 -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="历史命令" styleClass="dialog-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="关闭" onAction="#handleClose" styleClass="secondary-button"/>
    </HBox>
    
    <!-- 搜索区域 -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="搜索:" styleClass="text-secondary"/>
        <TextField fx:id="searchField" promptText="输入关键词搜索历史命令..." prefWidth="400"
                   onAction="#handleSearch"/>
        <Button text="搜索" onAction="#handleSearch" styleClass="primary-button"/>
        <Button text="清除" onAction="#handleClearSearch" styleClass="secondary-button"/>
    </HBox>
    
    <!-- 过滤选项 -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <CheckBox fx:id="caseSensitiveCheck" text="区分大小写"/>
        <CheckBox fx:id="regexCheck" text="正则表达式"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="共 " styleClass="text-secondary"/>
        <Label fx:id="totalCountLabel" text="0" styleClass="text-info"/>
        <Label text=" 条记录" styleClass="text-secondary"/>
    </HBox>
    
    <!-- 历史命令列表 -->
    <TableView fx:id="historyTable" prefHeight="350" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colIndex" text="#" prefWidth="50">
                <cellValueFactory>
                    <PropertyValueFactory property="index"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colCommand" text="命令" prefWidth="400">
                <cellValueFactory>
                    <PropertyValueFactory property="command"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colTime" text="时间" prefWidth="150">
                <cellValueFactory>
                    <PropertyValueFactory property="time"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colStatus" text="状态" prefWidth="80">
                <cellValueFactory>
                    <PropertyValueFactory property="status"/>
                </cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>
    
    <!-- 底部操作按钮 -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="⌨️ 执行选中命令" onAction="#handleExecute" styleClass="button-success"/>
        <Button text="复制到剪贴板" onAction="#handleCopy" styleClass="secondary-button"/>
        <Button text="删除选中" onAction="#handleDelete" styleClass="danger-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="导出历史" onAction="#handleExport" styleClass="secondary-button"/>
        <Button text="清空历史" onAction="#handleClearAll" styleClass="danger-button"/>
    </HBox>
    
</VBox>
