<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.runzhi.aishell.controller.NewConnectionConfigController" prefHeight="430" prefWidth="540" spacing="20" styleClass="form-dialog">
    <padding>
        <Insets bottom="24" left="24" right="24" top="24"/>
    </padding>
    <children>
        <Label text="新建连接配置" styleClass="page-title" />
        <GridPane hgap="16" vgap="14" VBox.vgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="100.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="200.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="34" prefHeight="34" vgrow="NEVER" />
                <RowConstraints minHeight="34" prefHeight="34" vgrow="NEVER" />
                <RowConstraints minHeight="34" prefHeight="34" vgrow="NEVER" />
                <RowConstraints minHeight="34" prefHeight="34" vgrow="NEVER" />
                <RowConstraints minHeight="34" prefHeight="34" vgrow="NEVER" />
                <RowConstraints minHeight="34" prefHeight="34" vgrow="NEVER" />
            </rowConstraints>
            <children>
                <Label text="配置名称:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="profileNameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                
                <Label text="主机地址:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="hostField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                
                <Label text="端口号:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="portField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                
                <Label text="用户名:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="usernameField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                
                <Label text="密码:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <PasswordField fx:id="passwordField" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <Label text="私钥路径:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <HBox GridPane.columnIndex="1" GridPane.rowIndex="5" spacing="5" alignment="CENTER_LEFT">
                    <TextField fx:id="privateKeyPathField" HBox.hgrow="ALWAYS"
                               promptText="可选，留空使用密码认证"/>
                    <Button text="浏览..." onAction="#browsePrivateKey"
                            styleClass="secondary-button" mnemonicParsing="false"/>
                </HBox>
            </children>
        </GridPane>
        <HBox alignment="BOTTOM_RIGHT" spacing="10.0" VBox.vgrow="NEVER">
            <children>
                <Button fx:id="saveButton" text="保存连接" onAction="#handleSave" styleClass="primary-button" />
                <Button fx:id="cancelButton" text="取消" onAction="#handleCancel" />
            </children>
        </HBox>
    </children>
</VBox>