<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.input.DragEvent?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.runzhi.aishell.controller.FileManagerPanelController"
      styleClass="file-manager-area" VBox.vgrow="ALWAYS">
    <SplitPane orientation="HORIZONTAL" VBox.vgrow="ALWAYS" dividerPositions="0.5">
        <VBox spacing="8" minWidth="0" styleClass="file-pane">
            <Label text="%fm.local.files" styleClass="section-title"/>
            <HBox alignment="CENTER_LEFT" spacing="5" styleClass="path-bar">
                <Label text="%fm.path" styleClass="text-secondary"/>
                <TextField fx:id="localPathField" HBox.hgrow="ALWAYS"
                           promptText="%fm.local.path.prompt" onAction="#navigateLocalPath"/>
                <Button text="%fm.browse" onAction="#browseLocalDirectory" styleClass="secondary-button"/>
                <Button text="%fm.up" onAction="#navigateLocalToParent" styleClass="secondary-button"/>
            </HBox>
            <FlowPane alignment="CENTER_LEFT" hgap="6" vgap="6" styleClass="file-toolbar">
                <Button text="%fm.new.folder" onAction="#createLocalFolder" styleClass="secondary-button"/>
                <Button text="%fm.delete" onAction="#deleteSelectedItems" styleClass="danger-button"/>
                <Button text="%fm.refresh" onAction="#refreshLocalList" styleClass="secondary-button"/>
                
                <Button text="%fm.upload" onAction="#uploadFiles" styleClass="upload-download-button"/>
            </FlowPane>
            <TableView fx:id="localFileTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="localNameColumn" text="%fm.col.name" prefWidth="180"/>
                    <TableColumn fx:id="localSizeColumn" text="%fm.col.size" prefWidth="85"/>
                    <TableColumn fx:id="localTypeColumn" text="%fm.col.permission" prefWidth="70"/>
                    <TableColumn fx:id="localDateColumn" text="%fm.col.modified" prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="file-pane" fx:id="remoteDropTarget"
              onDragOver="#onRemoteDragOver" onDragEntered="#onRemoteDragEntered"
              onDragExited="#onRemoteDragExited" onDragDropped="#onRemoteDragDropped">
            <Label text="%fm.remote.files" styleClass="section-title"/>
            <HBox alignment="CENTER_LEFT" spacing="5" styleClass="path-bar">
                <Label text="%fm.path" styleClass="path-label"/>
                <TextField fx:id="pathField" HBox.hgrow="ALWAYS" styleClass="path-field"
                           editable="true" onAction="#navigateRemotePath"
                           promptText="%fm.remote.path.prompt"/>
                <Button text="%fm.up" onAction="#navigateToParent" styleClass="secondary-button"/>
            </HBox>
            <FlowPane alignment="CENTER_LEFT" hgap="6" vgap="6" styleClass="file-toolbar">
                <Button text="%fm.new.folder" onAction="#createNewFolder" styleClass="secondary-button"/>
                <Button text="%fm.delete" onAction="#deleteSelectedItems" styleClass="danger-button"/>
                <Button text="%fm.refresh" onAction="#refreshFileList" styleClass="secondary-button"/>
                
                <Button text="%fm.download" onAction="#downloadFiles" styleClass="upload-download-button"/>
            </FlowPane>
            <TableView fx:id="remoteFileTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="remoteNameColumn" text="%fm.col.name" prefWidth="180"/>
                    <TableColumn fx:id="remoteSizeColumn" text="%fm.col.size" prefWidth="85"/>
                    <TableColumn fx:id="remoteTypeColumn" text="%fm.col.permission" prefWidth="70"/>
                    <TableColumn fx:id="remoteDateColumn" text="%fm.col.modified" prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </SplitPane>
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="stats-bar">
        <Label fx:id="statusLabel" text="%fm.ready"/>
        <ProgressBar fx:id="transferProgressBar" prefWidth="180" styleClass="transfer-progress-bar"
                     visible="false" managed="false"/>
        <Label fx:id="progressLabel"/>
        <Label fx:id="transferSpeedLabel"/>
        <Button fx:id="cancelTransferButton" text="%fm.cancel.transfer" onAction="#cancelTransfer"
                visible="false" managed="false" styleClass="danger-button"/>
        <Label fx:id="selectedCountLabel" visible="false" managed="false"/>
    </HBox>
</VBox>
